# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token. Enable the privileged MESSAGE CONTENT intent in the developer portal.
DISCORD_TOKEN=
# Only answer in these guilds (space or comma separated). Empty = every guild.
GUILD_ID=
# Optional: restrict !join / !leave to this role (Manage Server always works).
CONTROLLER_ROLE_ID=
COMMAND_PREFIX=!
# Optional: a voice channel to join on startup (must be in a GUILD_ID guild when that is set).
AUTO_JOIN_CHANNEL_ID=

# ─── Speech to text ─────────────────────────────────────────────────────────
# The URL picks the backend:
#   http(s)://…  Whisper: any OpenAI-compatible /v1/audio/transcriptions
#                endpoint, e.g. the local whisper.cpp server (default). In
#                Docker use http://host.docker.internal:8090/v1/audio/transcriptions.
#   ws(s)://…    Mistral Voxtral realtime, streams words as they are spoken:
#                wss://api.mistral.ai/v1/audio/transcriptions/realtime
STT_URL=http://127.0.0.1:8090/v1/audio/transcriptions
# Whisper: only for hosted endpoints. Mistral: required (MISTRAL_API_KEY also works).
STT_API_KEY=
# Whisper: optional. Mistral: defaults to voxtral-mini-transcribe-realtime-3.
STT_MODEL=
# Two-letter ISO 639-1 code (whisper also takes auto); empty = the backend's default.
STT_LANGUAGE=

# Whisper only: long utterances are transcribed in chunks of this many seconds.
STT_CHUNK_SECONDS=4
STT_TIMEOUT_SECONDS=20

# Mistral only: 80–1200 (or 2400); lower streams sooner, higher is more accurate.
STT_STREAMING_DELAY_MS=480
# Mistral only: recycle a speaker's socket after this much audio.
STT_MAX_SESSION_SECONDS=240

# ─── Gate and pacing ────────────────────────────────────────────────────────
# Loudness gate (RMS over 0..1): raise it in noisy channels.
VAD_RMS_THRESHOLD=0.012
# Consecutive loud 100 ms frames before a line opens.
VAD_SPEECH_FRAMES=2
# Silence that closes a line.
VAD_HANGOVER_MS=700
VAD_PREROLL_MS=400
VAD_MIN_UTTERANCE_MS=300
VAD_MAX_UTTERANCE_SECONDS=60
# Minimum gap between edits of one transcript message.
EDIT_INTERVAL_MS=1100
EDIT_JITTER_MS=250
# Leave when the channel has been empty this long.
IDLE_LEAVE_SECONDS=300
MAX_CONCURRENT_SPEAKERS=8

LOG_LEVEL=info
